{
  "name": "outlook-connector",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Desktop MCP middleman → Microsoft Graph (delegated, device-code)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/httpServer.ts",
    "start": "tsx src/httpServer.ts",
    "mcp": "tsx src/mcpServer.ts",
    "login": "tsx src/cliLogin.ts",
    "logout": "tsx src/cliLogout.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/msal-node": "^3.5.3",
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
