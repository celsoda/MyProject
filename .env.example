# Public-client app ID from Entra (Azure AD) — no client secret needed for device code
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# common = work/school + personal MSA | consumers = personal only | organizations = work only
AZURE_TENANT=common

# Optional: 64 hex chars or any passphrase. If unset, a key is created under .data/
# TOKEN_ENCRYPTION_KEY=

# Local data dir for encrypted MSAL cache + session metadata
DATA_DIR=.data

# Set to 1 for offline smoke (no Azure). Claude Desktop live test must leave this unset/0.
MOCK_GRAPH=0

# Optional HTTP API key for /v1/* (MCP stdio does not use this)
# CONNECTOR_API_KEY=dev-local-key

PORT=8787
